# Rockfall Monitor Configuration

# Detector
RF_DETECTOR_MODE=auto
RF_ROCK_WEIGHTS=models/rock.pt
RF_YOLO_CONF=0.45
RF_YOLO_IOU=0.50

# Motion Filter
RF_TAU=25
RF_THETA=0.015
RF_SIGMA=1.5
RF_MIN_AREA=400

# Tracking & Risk
RF_HISTORY_N=10
RF_IOU_MATCH=0.3
RF_MAX_AGE=5
RF_DANGER_BAND=0.25
RF_GRID=3

# Risk Weights (C, dA, P, proximity)
RF_W1=0.35
RF_W2=0.30
RF_W3=0.25
RF_W4=0.10

# Thresholds
RF_THETA_MOD=0.40
RF_THETA_HIGH=0.70

# Alerts
RF_DEBOUNCE_K=3
RF_COOLDOWN_S=300.0
RF_FRAME_SKIP=2

# Email
RF_SMTP_HOST=
RF_SMTP_PORT=587
RF_SMTP_USER=
RF_SMTP_PASS=
RF_ALERT_TO=
RF_SITE_LOCATION=Unknown site

# Siren
RF_SIREN_WEBHOOK=

# Server
RF_HOST=127.0.0.1
RF_PORT=8000
RF_CORS_ORIGIN=http://localhost:5173

# Storage
RF_DB_PATH=data/events.db
